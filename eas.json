{
  "cli": {
    "version": ">= 18.9.1"
  },
  "build": {
    "apk": {
      "android": {
        "buildType": "apk"
      },
      "channel": "apk"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  }
}
